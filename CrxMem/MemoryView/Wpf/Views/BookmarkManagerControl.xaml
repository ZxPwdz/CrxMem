<UserControl x:Class="CrxMem.MemoryView.Wpf.Views.BookmarkManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MemoryView.PanelBackgroundBrush}"
             Foreground="{DynamicResource MemoryView.TextPrimaryBrush}" PreviewKeyDown="Control_PreviewKeyDown">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/MemoryView.Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource MemoryView.PanelRaisedBrush}" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <TextBlock Text="Bookmark Manager" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Add" Click="Add_Click"/><Button Content="Edit" Click="Edit_Click"/><Button Content="Move Address" Click="Move_Click"/>
                <Button Content="Delete" Click="Delete_Click"/><Button Content="Navigate" Click="Navigate_Click"/>
                <Button Content="Rebind" Click="Rebind_Click" ToolTip="Bind a stale absolute bookmark to this executable"/>
                <Separator Margin="6,0"/><Button Content="Import" Click="Import_Click"/><Button Content="Export" Click="Export_Click"/>
                <Button Content="Refresh" Click="Refresh_Click"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource MemoryView.HeaderBackgroundBrush}" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <CheckBox x:Name="pinnedFirstBox" Content="Pinned first" Margin="8,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <ComboBox x:Name="stateFilter" Width="130" Margin="4,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All states" IsSelected="True"/><ComboBoxItem Content="Resolved"/><ComboBoxItem Content="Stale"/></ComboBox>
                <ComboBox x:Name="typeFilter" Width="150" Margin="4,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All annotations" IsSelected="True"/><ComboBoxItem Content="Bookmarks"/><ComboBoxItem Content="Comments only"/><ComboBoxItem Content="Module-relative"/><ComboBoxItem Content="Absolute"/></ComboBox>
                <TextBox x:Name="groupFilter" Width="85" Margin="4,0" TextChanged="Search_TextChanged" ToolTip="Filter by group"/>
                <TextBox x:Name="tagFilter" Width="80" Margin="4,0" TextChanged="Search_TextChanged" ToolTip="Filter by tag"/>
                <TextBox x:Name="colorFilter" Width="78" Margin="4,0" TextChanged="Search_TextChanged" ToolTip="Filter by color"/>
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="searchBox" TextChanged="Search_TextChanged" MinWidth="230" ToolTip="Label, comment, address, module, group, or tag (Ctrl+F)"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Pin selected" Click="Pin_Click"/><Button Content="Set group" Click="Group_Click"/><Button Content="Add tags" Click="Tags_Click"/><Button Content="Set color" Click="Color_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DataGrid x:Name="grid" Grid.Row="2" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pin" Binding="{Binding Pin}" Width="42"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="140"/>
                <DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="180"/>
                <DataGridTextColumn Header="Resolved" Binding="{Binding ResolvedAddress}" Width="145"/>
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="130"/>
                <DataGridTextColumn Header="Instruction" Binding="{Binding Instruction}" Width="180"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="2*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="110"/>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="150"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="145"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="145"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu><ContextMenu>
                <MenuItem Header="Navigate" Click="Navigate_Click"/><MenuItem Header="Edit" Click="Edit_Click" InputGestureText="F2"/>
                <MenuItem Header="Move address" Click="Move_Click"/><MenuItem Header="Rebind absolute address" Click="Rebind_Click"/>
                <Separator/><MenuItem Header="Copy expression" Click="Copy_Click"/><MenuItem Header="Delete" Click="Delete_Click" InputGestureText="Delete"/>
            </ContextMenu></DataGrid.ContextMenu>
        </DataGrid>
        <Border Grid.Row="3" Background="{StaticResource MemoryView.ToolbarBackgroundBrush}" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="statusText" Foreground="{StaticResource MemoryView.TextSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
