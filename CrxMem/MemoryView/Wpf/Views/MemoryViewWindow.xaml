<Window x:Class="CrxMem.MemoryView.Wpf.Views.MemoryViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:memoryControls="clr-namespace:CrxMem.MemoryView.Wpf.Controls"
        Title="CrxMem Memory View"
        Width="1360" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource MemoryView.WindowBackgroundBrush}"
        Foreground="{DynamicResource MemoryView.TextPrimaryBrush}">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ToggleBreakpointCommand}"/>
        <KeyBinding Key="F7" Command="{Binding StepIntoCommand}"/>
        <KeyBinding Key="F8" Command="{Binding StepOverCommand}"/>
        <KeyBinding Key="F8" Modifiers="Shift" Command="{Binding StepOutCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MemoryView.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MetaLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MemoryView.TextMutedBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MetaValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MemoryView.TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource MemoryView.MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>
            <Style x:Key="InfoName" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MemoryView.TextMutedBrush}"/>
                <Setter Property="Margin" Value="0,3,10,3"/>
            </Style>
            <Style x:Key="InfoValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MemoryView.TextSecondaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource MemoryView.MonoFont}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,3"/>
            </Style>
            <ContextMenu x:Key="PanelGridContextMenu" x:Shared="False">
                <MenuItem Header="_Go to Address" Click="PanelGoToAddress_Click"/>
                <Separator/>
                <MenuItem Header="_Copy Selected Rows" Click="PanelCopyRow_Click" InputGestureText="Ctrl+C"/>
            </ContextMenu>
            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PanelGrid_PreviewMouseLeftButtonDown"/>
                <EventSetter Event="PreviewMouseMove" Handler="PanelGrid_PreviewMouseMove"/>
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="PanelGrid_PreviewMouseLeftButtonUp"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="43"/>
            <RowDefinition Height="29"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="5,0">
            <MenuItem Header="_File"><MenuItem Header="_Close" Click="Close_Click" InputGestureText="Alt+F4"/></MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem x:Name="showInspectorMenu" Header="Show _Inspector" IsCheckable="True" IsChecked="True" Click="ShowInspector_Click"/>
                <MenuItem x:Name="showPatchEditorMenu" Header="Show _Patch Editor" IsCheckable="True" IsChecked="True" Click="ShowPatchEditor_Click"/>
                <Separator/>
                <MenuItem Header="Code Font _Larger" Click="CodeFontLarger_Click"/>
                <MenuItem Header="Code Font _Smaller" Click="CodeFontSmaller_Click"/>
                <MenuItem Header="_Dense Rows" Click="DenseRows_Click"/>
                <MenuItem Header="_Comfortable Rows" Click="ComfortableRows_Click"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Attach" Command="{Binding AttachCommand}"/>
                <MenuItem Header="_Detach" Command="{Binding DetachCommand}"/>
                <Separator/>
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}"/>
                <MenuItem Header="_Resume" Command="{Binding ResumeCommand}"/>
                <Separator/>
                <MenuItem Header="Step _Into" Command="{Binding StepIntoCommand}" InputGestureText="F7"/>
                <MenuItem Header="Step _Over" Command="{Binding StepOverCommand}" InputGestureText="F8"/>
                <MenuItem Header="Step O_ut" Command="{Binding StepOutCommand}" InputGestureText="Shift+F8"/>
                <MenuItem Header="Run to _Cursor" Command="{Binding RunToCursorCommand}"/>
                <MenuItem Header="Run Until _Return" Command="{Binding RunUntilReturnCommand}"/>
                <MenuItem Header="Toggle _Breakpoint" Command="{Binding ToggleBreakpointCommand}" InputGestureText="F2"/>
            </MenuItem>
            <MenuItem Header="_Search"><MenuItem Header="_Go to Address" Click="FocusAddress_Click" InputGestureText="Ctrl+G"/></MenuItem>
            <MenuItem Header="_Memory"><MenuItem Header="Apply verified byte patch in the patch pane" IsEnabled="False"/></MenuItem>
            <MenuItem Header="_Bookmarks" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Bookmark migration arrives with the metadata service"/>
            <MenuItem Header="_Tools" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="No WPF tools are available in this preview"/>
            <MenuItem Header="_Window" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Layout presets are planned"/>
            <MenuItem Header="_Help"><MenuItem Header="About this preview" Click="About_Click"/></MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource MemoryView.ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,5">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open Process" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Use the main CrxMem window to select a process"/>
                    <Button Content="Attach" Style="{StaticResource ToolbarButton}" Command="{Binding AttachCommand}" ToolTip="Attach the verified native debug session"/>
                    <Button Content="Detach" Style="{StaticResource ToolbarButton}" Command="{Binding DetachCommand}" ToolTip="Continue pending events and detach without terminating the target"/>
                    <Separator Margin="6,0"/>
                    <Button Content="❚❚ Pause" Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}"/>
                    <Button Content="▶ Run" Style="{StaticResource ToolbarButton}" Command="{Binding ResumeCommand}"/>
                    <Button Content="Step Into" Style="{StaticResource ToolbarButton}" Command="{Binding StepIntoCommand}" ToolTip="Trap-flag single step"/>
                    <Button Content="Step Over" Style="{StaticResource ToolbarButton}" Command="{Binding StepOverCommand}" ToolTip="Step over calls with a one-shot breakpoint"/>
                    <Button Content="Step Out" Style="{StaticResource ToolbarButton}" Command="{Binding StepOutCommand}" ToolTip="Run to the pointer-sized return address"/>
                    <Button Content="◉ Breakpoint" Style="{StaticResource ToolbarButton}" Command="{Binding ToggleBreakpointCommand}" Foreground="{StaticResource MemoryView.BreakpointBrush}" ToolTip="Toggle a verified software breakpoint"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="←" Command="{Binding BackCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Back (Alt+Left)"/>
                    <Button Content="→" Command="{Binding ForwardCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Forward (Alt+Right)"/>
                    <ComboBox x:Name="addressBox" Width="240" Margin="8,0,0,0" VerticalContentAlignment="Center"
                              IsEditable="True" IsTextSearchEnabled="False"
                              ItemsSource="{Binding RecentExpressions}"
                              FontFamily="{StaticResource MemoryView.MonoFont}"
                              Text="{Binding AddressExpression, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.InputBindings><KeyBinding Key="Enter" Command="{Binding NavigateCommand}"/></ComboBox.InputBindings>
                    </ComboBox>
                    <Button Content="Go" Command="{Binding NavigateCommand}" Margin="5,0,8,0"/>
                    <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Refresh inspection data"/>
                    <Button Content="⚙" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="MemoryView-specific settings are planned"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource MemoryView.HeaderBackgroundBrush}"
                BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Background="{StaticResource MemoryView.SelectionBackgroundBrush}" Padding="11,5" MinWidth="190">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource MemoryView.GreenBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="  Inspection" Foreground="{StaticResource MemoryView.TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Button Content="+" IsEnabled="False" Width="35" BorderThickness="0" ToolTipService.ShowOnDisabled="True" ToolTip="Multi-session support is not implemented"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="580"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="inspectorColumn" Width="350" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition x:Name="bottomToolsRow" Height="255" MinHeight="160"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource MemoryView.PanelRaisedBrush}"
                        BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Module:" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ModuleName}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Base:" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ModuleBase}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Architecture:" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding Architecture}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Mode:" Style="{StaticResource MetaLabel}"/><TextBlock Text="Inspection" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Address:" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding CurrentAddress}" Style="{StaticResource MetaValue}"/>
                        <TextBlock Text="Offset:" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding Offset}" Style="{StaticResource MetaValue}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" CanContentScroll="True"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <memoryControls:VirtualizedDisassemblyControl
                        x:Name="disassemblyView"
                        ItemsSource="{Binding Instructions}"
                        SelectedItem="{Binding SelectedInstruction, Mode=TwoWay}">
                        <memoryControls:VirtualizedDisassemblyControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy _Instruction" Click="CopyDisassemblyRow_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Copy _Address" Click="CopyDisassemblyAddress_Click"/>
                                <MenuItem Header="Copy _Bytes" Click="CopyDisassemblyBytes_Click"/>
                                <Separator/>
                                <MenuItem Header="Toggle _Breakpoint" Click="ToggleBreakpointContext_Click" InputGestureText="F2"/>
                                <MenuItem Header="Replace with _NOPs" Click="NopInstructionContext_Click"/>
                            </ContextMenu>
                        </memoryControls:VirtualizedDisassemblyControl.ContextMenu>
                    </memoryControls:VirtualizedDisassemblyControl>
                </ScrollViewer>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Style="{StaticResource MemoryView.Splitter}"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="patchEditorColumn" Width="350" MinWidth="0"/></Grid.ColumnDefinitions>
                    <TabControl x:Name="toolsTabControl" Grid.Column="0">
                        <TabItem Header="Hex Dump">
                            <memoryControls:VirtualizedHexDumpControl x:Name="hexDumpView" ItemsSource="{Binding HexRows}">
                                <memoryControls:VirtualizedHexDumpControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy _Byte" Click="CopyHexByte_Click"/>
                                        <MenuItem Header="Copy _Address" Click="CopyHexAddress_Click"/>
                                        <Separator/>
                                        <MenuItem Header="_Go to Selected Address" Click="GoToHexAddress_Click"/>
                                    </ContextMenu>
                                </memoryControls:VirtualizedHexDumpControl.ContextMenu>
                            </memoryControls:VirtualizedHexDumpControl>
                        </TabItem>
                        <TabItem Header="Stack">
                            <DataGrid x:Name="stackGrid" ItemsSource="{Binding StackRows}" AutoGenerateColumns="False" IsReadOnly="True" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="155"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="155"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Watch">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="8,6">
                                    <Button Content="Add" DockPanel.Dock="Right" Command="{Binding AddWatchCommand}" Margin="5,0,0,0"/>
                                    <TextBox Text="{Binding WatchExpression, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MemoryView.MonoFont}">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddWatchCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <DataGrid x:Name="watchGrid" Grid.Row="1" ItemsSource="{Binding Watches}" AutoGenerateColumns="False" IsReadOnly="True" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="*"/>
                                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="145"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="145"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Breakpoints">
                            <TabControl x:Name="breakpointTabControl">
                                <TabItem Header="Software">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DataGrid x:Name="softwareBreakpointsGrid" ItemsSource="{Binding Breakpoints}" SelectedItem="{Binding SelectedBreakpoint}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="PanelGrid_MouseDoubleClick" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Address" Binding="{Binding Address, StringFormat={}{0:X16}}" Width="155"/>
                                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="65"/>
                                                <DataGridTextColumn Header="Hits" Binding="{Binding HitCount}" Width="55"/>
                                                <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="1" Content="Toggle Selected" Command="{Binding ToggleSelectedBreakpointCommand}" HorizontalAlignment="Right" Margin="6"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Hardware">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="6">
                                            <TextBox Width="145" Text="{Binding HardwareBreakpointAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MemoryView.MonoFont}"/>
                                            <ComboBox Width="90" Margin="5,0" ItemsSource="{Binding HardwareAccessOptions}" SelectedItem="{Binding HardwareBreakpointAccess}"/>
                                            <ComboBox Width="75" ItemsSource="{Binding HardwareSizeOptions}" SelectedItem="{Binding HardwareBreakpointSize}"/>
                                            <Button Content="Add" Command="{Binding SetHardwareBreakpointCommand}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <DataGrid x:Name="hardwareBreakpointsGrid" Grid.Row="1" ItemsSource="{Binding HardwareBreakpoints}" SelectedItem="{Binding SelectedHardwareBreakpoint}" AutoGenerateColumns="False" IsReadOnly="True" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Slot" Binding="{Binding Slot, StringFormat=DR{0}}" Width="50"/>
                                                <DataGridTextColumn Header="Address" Binding="{Binding Address, StringFormat={}{0:X16}}" Width="155"/>
                                                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="90"/>
                                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70"/>
                                                <DataGridTextColumn Header="Hits" Binding="{Binding HitCount}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="2" Content="Clear Selected" Command="{Binding ClearHardwareBreakpointCommand}" HorizontalAlignment="Right" Margin="6"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Call Stack">
                            <DataGrid x:Name="callStackGrid" ItemsSource="{Binding CallStackFrames}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="PanelGrid_MouseDoubleClick" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="38"/>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="155"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="210"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Memory Map">
                            <DataGrid x:Name="memoryMapGrid" ItemsSource="{Binding MemoryMap}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="PanelGrid_MouseDoubleClick" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Base" Binding="{Binding BaseAddress}" Width="155"/>
                                    <DataGridTextColumn Header="End" Binding="{Binding EndAddress}" Width="155"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                                    <DataGridTextColumn Header="Protection" Binding="{Binding Protection}" Width="110"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="85"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Patches">
                            <DataGrid x:Name="patchHistoryGrid" ItemsSource="{Binding PatchHistory}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="PanelGrid_MouseDoubleClick" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="155"/>
                                    <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="130"/>
                                    <DataGridTextColumn Header="Patched" Binding="{Binding Patched}" Width="130"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="75"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Modules">
                            <DataGrid x:Name="modulesGrid" ItemsSource="{Binding Modules}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="PanelGrid_MouseDoubleClick" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Base" Binding="{Binding BaseAddress}" Width="155"/>
                                    <DataGridTextColumn Header="End" Binding="{Binding EndAddress}" Width="155"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Threads">
                            <DataGrid x:Name="threadsGrid" ItemsSource="{Binding Threads}" AutoGenerateColumns="False" IsReadOnly="True" ContextMenu="{StaticResource PanelGridContextMenu}" PreviewMouseRightButtonDown="PanelGrid_PreviewMouseRightButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="75"/>
                                    <DataGridTextColumn Header="Start" Binding="{Binding StartAddress, StringFormat={}{0:X16}}" Width="155"/>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="75"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                    <GridSplitter x:Name="patchSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Style="{StaticResource MemoryView.Splitter}"/>
                    <Border x:Name="patchEditorPane" Grid.Column="2" Background="{StaticResource MemoryView.PanelBackgroundBrush}" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource MemoryView.PaneHeader}"><TextBlock Text="Assembler / Patch" FontWeight="SemiBold"/></Border>
                            <StackPanel Grid.Row="1" Margin="10">
                                <TextBlock Text="Address" Foreground="{StaticResource MemoryView.TextMutedBrush}"/>
                                <TextBox Text="{Binding SelectedInstructionAddress, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MemoryView.MonoFont}" Margin="0,3,0,8"/>
                                <TextBlock Text="Original bytes" Foreground="{StaticResource MemoryView.TextMutedBrush}"/>
                                <TextBox Text="{Binding SelectedInstructionBytes, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MemoryView.MonoFont}" Margin="0,3,0,8"/>
                                <TextBlock Text="Instruction" Foreground="{StaticResource MemoryView.TextMutedBrush}"/>
                                <TextBox Text="{Binding SelectedInstructionText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MemoryView.MonoFont}" Height="60" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <TextBlock Text="Replacement bytes" Foreground="{StaticResource MemoryView.TextMutedBrush}"/>
                                <TextBox Text="{Binding PatchBytes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MemoryView.MonoFont}" Margin="0,3,0,5"/>
                                <CheckBox Content="Explicitly NOP-pad shorter replacements" IsChecked="{Binding PadPatchWithNops}" Margin="0,2,0,8"/>
                                <TextBlock Text="Writes verify original bytes, restore protection, flush the instruction cache, read back, and roll back on failure. Assembly stays disabled until its parser is extracted and tested."
                                           Foreground="{StaticResource MemoryView.TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <UniformGrid Grid.Row="2" Columns="5" Margin="8">
                                <Button Content="Assemble" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Assembler parser is not yet verified" Margin="2"/>
                                <Button Content="Apply Patch" Command="{Binding ApplyPatchCommand}" Margin="2"/>
                                <Button Content="New NOPs" Command="{Binding NopInstructionCommand}" Margin="2"/>
                                <Button Content="Undo" Command="{Binding UndoPatchCommand}" Margin="2"/>
                                <Button Content="Redo" Command="{Binding RedoPatchCommand}" Margin="2"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter x:Name="inspectorSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Style="{StaticResource MemoryView.Splitter}"/>

            <Grid x:Name="inspectorPane" Grid.Column="2" Background="{StaticResource MemoryView.PanelBackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition x:Name="registerPanelRow" Height="3*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource MemoryView.PaneHeader}"><DockPanel><TextBlock Text="Registers" FontWeight="SemiBold"/><TextBlock Text="{Binding DebugStateText}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MemoryView.TextMutedBrush}"/></DockPanel></Border>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Registers}" Margin="10,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="20">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MemoryView.TextSecondaryBrush}" FontFamily="{StaticResource MemoryView.MonoFont}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:X16}}" FontFamily="{StaticResource MemoryView.MonoFont}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MemoryView.TextPrimaryBrush}"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasChanged}" Value="True"><Setter Property="Foreground" Value="{StaticResource MemoryView.RedBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding SignedDelta, StringFormat={}{0:+#;-#;0}}" HorizontalAlignment="Right" Foreground="{StaticResource MemoryView.TextMutedBrush}" FontFamily="{StaticResource MemoryView.MonoFont}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRegisterSnapshot}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                </StackPanel.Style>
                                <TextBlock Text="Registers require a paused debugger session" HorizontalAlignment="Center" Foreground="{StaticResource MemoryView.TextSecondaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DebugStopReason}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MemoryView.TextMutedBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="RFLAGS  " Foreground="{StaticResource MemoryView.TextMutedBrush}"/><TextBlock Text="{Binding FlagsText}" FontFamily="{StaticResource MemoryView.MonoFont}"/></StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Style="{StaticResource MemoryView.Splitter}"/>
                <Border Grid.Row="2" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource MemoryView.PaneHeader}"><TextBlock Text="Information" FontWeight="SemiBold"/></Border>
                        <Grid Grid.Row="1" Margin="12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Address" Style="{StaticResource InfoName}"/><TextBlock Grid.Column="1" Text="{Binding SelectedInstructionAddress}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="1" Text="Module" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModuleName}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="2" Text="Offset" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Offset}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="3" Text="Protection" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Protection}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="4" Text="Region" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Region}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="5" Text="Bytes" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedInstructionBytes}" Style="{StaticResource InfoValue}"/>
                            <TextBlock Grid.Row="6" Text="Instruction" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedInstructionText}" Style="{StaticResource InfoValue}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="7" Text="Comment" Style="{StaticResource InfoName}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedInstructionComment}" Style="{StaticResource InfoValue}" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource MemoryView.ToolbarBackgroundBrush}" BorderBrush="{StaticResource MemoryView.BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="9,0">
                <Border Background="{StaticResource MemoryView.SelectionBackgroundBrush}" Padding="7,2" Margin="-9,0,10,0"><TextBlock Text="Inspection mode" FontSize="11"/></Border>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource MemoryView.TextSecondaryBrush}" FontSize="11"/>
                <ProgressBar DockPanel.Dock="Right" Width="90" Height="3" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </DockPanel>
        </Border>
    </Grid>
</Window>
