<Window x:Class="CrxMem.MemoryView.Wpf.Views.AutoAssemblerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrxMem Auto Assembler" Width="920" Height="700" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MemoryView.WindowBackgroundBrush}"
        Foreground="{DynamicResource MemoryView.TextPrimaryBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/MemoryView.Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Auto Assembler" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="templateBox" DockPanel.Dock="Right" Width="190" SelectionChanged="TemplateBox_SelectionChanged">
                <ComboBoxItem Content="Templates…" IsSelected="True"/><ComboBoxItem Content="Code injection"/><ComboBoxItem Content="AOB injection"/><ComboBoxItem Content="Full injection"/>
            </ComboBox>
        </DockPanel>
        <TextBox x:Name="sourceEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" SpellCheck.IsEnabled="False"/>
        <Grid Grid.Row="2" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Diagnostics" Margin="0,0,4,0"><ListBox x:Name="diagnosticsList" FontFamily="Consolas"/></GroupBox>
            <GroupBox Grid.Column="1" Header="Execution preview" Margin="4,0,0,0"><TextBox x:Name="previewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></GroupBox>
        </Grid>
        <DockPanel Grid.Row="3"><TextBlock x:Name="statusText" VerticalAlignment="Center" Foreground="{DynamicResource MemoryView.TextSecondaryBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Syntax Check" Click="Check_Click" Margin="4,0" Padding="12,5"/>
                <Button Content="Preview Enable" Click="Preview_Click" Margin="4,0" Padding="12,5"/>
                <Button Content="Enable" Click="Enable_Click" Margin="4,0" Padding="12,5"/>
                <Button Content="Disable" Click="Disable_Click" Margin="4,0" Padding="12,5"/>
                <Button Content="Close" Click="Close_Click" Margin="4,0" Padding="12,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
