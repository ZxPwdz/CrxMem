<Window x:Class="CrxMem.MemoryView.Wpf.Views.BookmarkEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmark / Annotation" Width="560" Height="500" MinWidth="480" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MemoryView.WindowBackgroundBrush}" Foreground="{DynamicResource MemoryView.TextPrimaryBrush}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/MemoryView.Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Address" VerticalAlignment="Center"/><TextBox x:Name="addressBox" Grid.Column="1" Margin="0,3" FontFamily="Consolas"/>
        <TextBlock Grid.Row="1" Text="Label" VerticalAlignment="Center"/><TextBox x:Name="labelBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="2" Text="Comment" VerticalAlignment="Top" Margin="0,7,0,0"/>
        <TextBox x:Name="commentBox" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Margin="0,3" Height="120"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBlock Text="Group" VerticalAlignment="Center"/><TextBox x:Name="groupBox" Grid.Column="1" Margin="0,3,8,3"/>
            <TextBlock Grid.Column="2" Text="Color" VerticalAlignment="Center"/><ComboBox x:Name="colorBox" Grid.Column="3" IsEditable="True" Margin="0,3">
                <ComboBoxItem Content="#39A9FF"/><ComboBoxItem Content="#55D96B"/><ComboBoxItem Content="#FFC857"/>
                <ComboBoxItem Content="#FF6B6B"/><ComboBoxItem Content="#C792EA"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="5" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Tags" VerticalAlignment="Center"/><TextBox x:Name="tagsBox" Grid.Column="1" Margin="0,3,8,3" ToolTip="Comma-separated tags"/>
            <CheckBox x:Name="bookmarkBox" Grid.Column="2" Content="Bookmark" Margin="8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="pinnedBox" Grid.Column="3" Content="Pinned" Margin="8,0" VerticalAlignment="Center"/>
        </Grid>
        <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <TextBlock x:Name="previewText" Foreground="{StaticResource MemoryView.TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="18,6" Margin="4,0"/>
                <Button Content="Cancel" IsCancel="True" Padding="18,6" Margin="4,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
