<Window x:Class="CrxMem.MemoryView.Wpf.Views.MetadataEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comment / Bookmark" Width="470" Height="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MemoryView.WindowBackgroundBrush}"
        Foreground="{DynamicResource MemoryView.TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/MemoryView.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Comment" Foreground="{StaticResource MemoryView.TextSecondaryBrush}" Margin="0,0,0,5"/>
        <TextBox x:Name="commentBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MemoryView.MonoFont}"/>
        <CheckBox x:Name="bookmarkBox" Grid.Row="2" Content="Bookmark this instruction" Margin="0,12,0,8"/>
        <DockPanel Grid.Row="3">
            <TextBlock Text="Bookmark label" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource MemoryView.TextSecondaryBrush}"/>
            <TextBox x:Name="labelBox"/>
        </DockPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="86" Margin="4,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="86" Margin="4,0" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
