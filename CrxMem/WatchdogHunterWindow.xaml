<Window x:Class="CrxMem.WatchdogHunterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watchdog Hunter"
        Width="1020" Height="760"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="HexField" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="2,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + status -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Watchdog Hunter" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Find the hidden integrity-check thread: enumerate thread start addresses, flag suspects, suspend in bisection rounds."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Border x:Name="statusBanner" DockPanel.Dock="Right" VerticalAlignment="Center"
                    Background="{StaticResource BackgroundCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="12,0,0,0">
                <TextBlock x:Name="txtStatus" Text="—" FontFamily="Consolas" FontSize="12"/>
            </Border>
        </DockPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnRefresh" Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click"/>
                <CheckBox x:Name="chkAutoRefresh" Content="Auto-refresh (2s)" Margin="12,0,0,0"
                          VerticalAlignment="Center" Checked="ChkAutoRefresh_Changed" Unchecked="ChkAutoRefresh_Changed"/>
                <Rectangle Width="1" Fill="{StaticResource BorderDefaultBrush}" Margin="12,2"/>
                <Button x:Name="btnSuspendSelected" Content="Suspend selected" Margin="0,0,6,0"
                        Style="{StaticResource ModernButtonStyle}" Click="SuspendSelected_Click"/>
                <Button x:Name="btnResumeSelected" Content="Resume selected" Margin="0,0,6,0"
                        Style="{StaticResource ModernButtonStyle}" Click="ResumeSelected_Click"/>
                <Button x:Name="btnResumeAll" Content="RESUME ALL (panic)"
                        Style="{StaticResource DangerButtonStyle}" Click="ResumeAll_Click"
                        ToolTip="Resume every thread in the target process, repeatedly, until none remain suspended."/>
            </StackPanel>
        </Border>

        <!-- Suspect ranges -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Suspect range start (hex)" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <TextBox x:Name="txtSuspectStart" Style="{StaticResource HexField}" Width="230"
                         Text="0x037F5000;0x04068000" TextChanged="SuspectRanges_TextChanged"
                         ToolTip="Semicolon-separated hex start addresses. Entries pair by position with the end addresses."/>
                <TextBlock Text="end (hex)" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                <TextBox x:Name="txtSuspectEnd" Style="{StaticResource HexField}" Width="230"
                         Text="0x04060AE3;0x050EC35C" TextChanged="SuspectRanges_TextChanged"
                         ToolTip="Semicolon-separated hex end addresses (inclusive). Entries pair by position with the start addresses."/>
                <TextBlock Text="Red rows: start address outside all modules (injected/orphan) or inside these ranges."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Kernel watchpoint (hardware breakpoints via CrxShield driver) -->
        <GroupBox x:Name="grpKernelWatchpoint" Grid.Row="3" Header="Kernel watchpoint (DR0–DR3)"
                  Background="{StaticResource BackgroundCardBrush}"
                  BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                  Padding="10,6" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Address" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <TextBox x:Name="txtWatchpointAddress" Style="{StaticResource HexField}" Width="190"
                         Text="Gunz.exe+" ToolTip="Either module+offset (Gunz.exe+2BDC7D — easiest) or a raw hex VA (0x42DC7D)."/>
                <TextBlock Text="Slot" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                <ComboBox x:Name="cmbWatchpointSlot" Style="{StaticResource ModernComboBoxStyle}"
                          Width="76" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="DR0"/>
                    <ComboBoxItem Content="DR1"/>
                    <ComboBoxItem Content="DR2"/>
                    <ComboBoxItem Content="DR3"/>
                </ComboBox>
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                <ComboBox x:Name="cmbWatchpointType" Style="{StaticResource ModernComboBoxStyle}"
                          Width="104" SelectedIndex="1" VerticalAlignment="Center">
                    <ComboBoxItem Content="Execute"/>
                    <ComboBoxItem Content="Write"/>
                    <ComboBoxItem Content="Read-Write"/>
                </ComboBox>
                <Button x:Name="btnSetWatchpoint" Content="Set watchpoint" Margin="12,0,6,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="SetWatchpoint_Click"
                        ToolTip="Program this hardware breakpoint into every thread of the target via the CrxShield driver."/>
                <Button x:Name="btnClearWatchpoints" Content="Clear all watchpoints"
                        Style="{StaticResource ModernButtonStyle}" Click="ClearWatchpoints_Click"
                        ToolTip="Clear DR0–DR3 in every thread of the target via the CrxShield driver."/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkVehMode" Content="In-process (no lag)" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="Checked: catch hits inside the target via VEH — no debug port, no BeingDebugged flag, no lag. Unchecked: external Windows debugger (can lag fullscreen games; visible to anti-debug)."/>
                        <Button x:Name="btnCatchDb" Content="Catch #DB hits"
                                Style="{StaticResource PrimaryButtonStyle}" Click="CatchDb_Click"
                                ToolTip="Record every hardware-watchpoint hit (TID, watched address, reader EIP) without stopping the game. Start this BEFORE setting a watchpoint (debug-port mode) — an unhandled #DB crashes the target."/>
                        <TextBlock x:Name="txtDbCatchStatus" Text="not catching"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Start the catcher FIRST, then set the watchpoint — otherwise a hit arrives as an unhandled #DB and crashes the target."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"
                               MaxWidth="260" TextWrapping="Wrap"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>

        <!-- Thread list -->
        <ListView x:Name="lstThreads" Grid.Row="4"
                  Background="{StaticResource BackgroundInputBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderDefaultBrush}" FontFamily="Consolas" FontSize="12"
                  SelectionMode="Extended">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuspendedByUs}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSuspect}" Value="True">
                            <Setter Property="Background" Value="{StaticResource StatusErrorBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="✓" Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}"/>
                    <GridViewColumn Header="Thread ID" Width="90" DisplayMemberBinding="{Binding ThreadIdText}"/>
                    <GridViewColumn Header="Start Address" Width="110" DisplayMemberBinding="{Binding StartAddressText}"/>
                    <GridViewColumn Header="Module / Section" Width="260" DisplayMemberBinding="{Binding ModuleText}"/>
                    <GridViewColumn Header="State" Width="110" DisplayMemberBinding="{Binding StateText}"/>
                    <GridViewColumn Header="Susp." Width="55" DisplayMemberBinding="{Binding SuspendedText}"/>
                    <GridViewColumn Header="Suspect" Width="70" DisplayMemberBinding="{Binding SuspectText}"/>
                    <GridViewColumn Header="Actions" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Suspend" Tag="{Binding}" Style="{StaticResource RowButton}" Click="RowSuspend_Click"/>
                                    <Button Content="Resume" Tag="{Binding}" Style="{StaticResource RowButton}" Click="RowResume_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Bisection assistant -->
        <Border Grid.Row="5" Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Bisection log" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtLog" Style="{StaticResource ModernTextBoxStyle}" Height="168"
                             IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="btnSelectSuspects" Content="Select all suspects" Margin="0,0,6,0"
                                Style="{StaticResource ModernButtonStyle}" Click="SelectSuspects_Click"/>
                        <Button x:Name="btnSuspendChecked" Content="Suspend checked"
                                Style="{StaticResource ModernButtonStyle}" Click="SuspendChecked_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="btnMarkCrashed" Content="Mark round: CRASHED" Margin="0,0,6,0"
                                Style="{StaticResource DangerButtonStyle}" Click="MarkCrashed_Click"
                                ToolTip="The target crashed or the detection still fired this round."/>
                        <Button x:Name="btnMarkClean" Content="Mark round: CLEAN"
                                Style="{StaticResource PrimaryButtonStyle}" Click="MarkClean_Click"
                                ToolTip="The detection did not fire this round — a suspended thread is the watchdog."/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Round timer (s)" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtRoundSeconds" Style="{StaticResource HexField}" Width="60" Text="70"
                                 DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                        <Button x:Name="btnTimerStart" Content="Start" Margin="8,0,6,0"
                                Style="{StaticResource ModernButtonStyle}" Click="TimerStart_Click"
                                ToolTip="Start after applying your memory patch; the watchdog fires roughly once per cycle."/>
                        <Button x:Name="btnTimerReset" Content="Reset"
                                Style="{StaticResource ModernButtonStyle}" Click="TimerReset_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="txtCountdown" Text="--:--" FontFamily="Consolas" FontSize="30"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
